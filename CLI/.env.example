# BrowserStonks environment — copy to .env and fill in your keys.
# Loaded by the CLI before integrations start; config.jsonc values
# reference these via ${VAR} expansion.

# --- LLM provider (choose one; must match llm.provider in config.jsonc) ---
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Alternative providers (uncomment + set llm.provider accordingly):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# --- CLI overrides ---
# BROWSERSTONKS_HOME=/path/to/config/dir   # config root other than the CLI dir

# --- MCP servers (referenced from config.jsonc mcpServers.*.env) ---
# MY_MCP_TOKEN=
