{
  "manifest_version": 3,
  "name": "BrowserStonks",
  "version": "0.1.0",
  "description": "Automated form filling driven by the BrowserStonks CLI. Injects Pyodide (Python/WASM) and runs programs generated by the CLI.",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BrowserStonks: fill this form",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [],
  "icons": {}
}
