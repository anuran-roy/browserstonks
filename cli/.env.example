# BrowserStonks environment — copy to .env and fill in your keys.
# Loaded by the CLI before integrations start; config.jsonc values
# reference these via ${VAR} expansion.

# --- LLM provider (choose one; must match llm.provider in config.jsonc) ---
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Alternative providers (uncomment + set llm.provider accordingly):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# --- CLI overrides ---
# BROWSERSTONKS_HOME=/path/to/config/dir   # config root other than the CLI dir

# --- Logging ---
# Log level override: DEBUG | INFO | WARNING | ERROR
# (same as `browserstonks serve --debug` / `--verbose`)
# BROWSERSTONKS_LOG=DEBUG

# --- Harness servers (referenced from config.jsonc harnesses.*) ---
# opencode server (base_url in config.jsonc, usually no auth needed locally):
# OPENCODE_TOKEN=
# OpenClaw gateway (gateway.auth.token from ~/.openclaw/openclaw.json):
# OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_API_KEY=
# Hermes (CLI-driven by default; token only if you expose an HTTP gateway):
# HERMES_USER=
# HERMES_PASS=

# --- MCP servers (referenced from config.jsonc mcpServers.*.env) ---
# MY_MCP_TOKEN=

# --- Managed storage (config: storage.enabled=true) ---
# provider (storage.provider in config.jsonc): cloudinary (default) | s3 | gcs
# Docs are always written locally to media/<sessionId>/; when enabled they
# are ALSO uploaded and doc.open points at the served URL.
# Fill in ONLY the block matching your provider:

# Cloudinary (default provider)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Amazon S3 (storage.provider = "s3")
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (storage.provider = "gcs")
GCS_BUCKET=
GCS_ACCESS_TOKEN=

# --- Secure internet mode (config: auth.required=true) ---
# Connection tokens are NOT stored here — issue and manage them with:
#   browserstonks tokens issue --label <name>
#   browserstonks tokens list
#   browserstonks tokens revoke <token-or-label>
# Token DB: sqlite tokens.db by default; point auth.database in
# config.jsonc at a postgres://… or mongodb://… DSN for a shared DB
# (psycopg / pymongo installed separately).

# --- Local OpenAI-compatible providers (config: llm.provider) ---
# lmstudio  -> http://127.0.0.1:1234/v1   (LM Studio server)
# llamacpp  -> http://127.0.0.1:8080/v1   (llama-server)
# llmd      -> http://127.0.0.1:8081/v1
# ollama    -> http://127.0.0.1:11434/v1  (Ollama's OpenAI-compat endpoint)
# API keys are OPTIONAL for these (bearer header sent only when set —
# most local servers ignore auth; Ollama checks it only when its own
# OLLAMA_API_KEY is configured server-side). Override ports via
# llm.base_url in config.jsonc.
# LMSTUDIO_API_KEY=
# LLAMACPP_API_KEY=
# LLMD_API_KEY=
# OLLAMA_API_KEY=

# --- OpenCode harness model selection (picked up at session start) ---
# Every opencode prompt is sent with this model override; unset = the
# server's configured default model.
# OPENCODE_MODEL_PROVIDER=lmstudio
# OPENCODE_MODEL_ID=openai/gpt-oss-20b
# Shorthand: setting only <KIND>_MODEL_ID (e.g. OLLAMA_MODEL_ID=llama3)
# implies providerID=<kind>.
# OLLAMA_MODEL_ID=
# LMSTUDIO_MODEL_ID=
# LLAMACPP_MODEL_ID=
# LLMD_MODEL_ID=

# --- OpenCode server auth (when started with OPENCODE_SERVER_PASSWORD) ---
# maps to harnesses.opencode.auth = basic auth in config.jsonc:
#   "auth": {"type": "basic", "username": "${OPENCODE_USERNAME}", "password": "${OPENCODE_SERVER_PASSWORD}"}
# OPENCODE_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
