// BrowserStonks configuration (auto-configured by setup.sh; edit freely).
// Schema: config.schema.jsonc · values support ${VAR} expansion from .env
{
  "llm": {
    "provider": "${LLM_PROVIDER}",
    "model": "${LLM_MODEL}",
    "api_key": "${LLM_API_KEY}"
  },
  "integrations": {
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765
    },
    "stdio": {
      "enabled": false
    }
  },
  "formAdapters": {
    "generic": true,
    "google_forms": true,
    "typeform": true
  },
  "answersFile": "answers.jsonc",
  "docsDir": "docs",
  // generated content (doc.create) is written to media/<sessionId>/;
  // when storage.enabled, it is ALSO uploaded to managed storage and
  // the doc.open event points at the served URL.
  // provider: cloudinary (default) | s3 | gcs — credentials in .env
  "storage": {
    "enabled": false,
    "provider": "cloudinary"
  },
  // secure internet mode: when required, every websocket client must
  // send {"type":"auth","token":"…"} as its first message. Issue tokens
  // with `browserstonks tokens issue --label <name>`.
  // database: default sqlite (tokens.db); also accepts
  // postgres://… or mongodb://… DSNs (driver optional).
  "auth": {
    "required": true
  },
  "harnesses": {
    "opencode": {
      "base_url": "http://127.0.0.1:4096"
    },
    "openclaw": {
      "base_url": "http://127.0.0.1:18789",
      "auth": {
        "type": "bearer",
        "token": "29055f88051287c3fc437f2f386bf468043ff0baf3495b7c"
      }
    },
    "hermes": {
      "base_url": "http://127.0.0.1:9119"
    }
  },
  "mcpServers": {}
}
